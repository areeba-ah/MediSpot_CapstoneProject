<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layout"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        tools:context=".User.QRScanner">

            <RelativeLayout
                android:id="@+id/menulayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="15dp"
                android:paddingBottom="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/Primary_color">

                <ImageView
                    android:id="@+id/back_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:onClick="back_btn"
                    android:paddingTop="7dp"
                    app:srcCompat="@drawable/ic_baseline_arrow_back_24"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="146dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="MediSpot"
                    android:textColor="@color/white"
                    android:textSize="28dp"
                    android:textStyle="bold"
                    android:layout_toEndOf="@id/back_btn"/>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/screen"
                android:layout_width="match_parent"
                android:layout_height="750dp"
                android:transitionName="login_screen"
                app:layout_constraintTop_toBottomOf="@+id/menulayout"
                android:orientation="vertical">

                <FrameLayout
                    android:id= "@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background = "#00000000">

                    <androidx.camera.view.PreviewView
                        android:id= "@+id/previewview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"></androidx.camera.view.PreviewView>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/image"
                            android:layout_width="300dp"
                            android:layout_height="300dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/background_image"></ImageView>
                    </RelativeLayout>

                </FrameLayout>
            </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>












